#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

DEST="${RMOTE_INSTALL_DIR:-/Applications}/rmote.app"
IDENTITY="${CODE_SIGN_IDENTITY:--}"
TEAM="${DEVELOPMENT_TEAM:-}"

"$ROOT/script/setup"

echo "Building Release with: $IDENTITY${TEAM:+ (team $TEAM)}"
xcodebuild build \
  -scheme "rmote" \
  -destination 'platform=macOS' \
  -derivedDataPath "$ROOT/DerivedData" \
  -configuration Release \
  CODE_SIGN_IDENTITY="$IDENTITY" \
  DEVELOPMENT_TEAM="$TEAM" \
  CODE_SIGN_STYLE=Manual

APP="$ROOT/DerivedData/Build/Products/Release/rmote.app"
if [ ! -d "$APP" ]; then
  echo "Built app not found at $APP" >&2
  exit 1
fi

pkill -f "rmote.app/Contents/MacOS/rmote" 2>/dev/null || true
sleep 0.5

echo "Installing to $DEST"
rm -rf "$DEST"
cp -R "$APP" "$DEST"
xattr -cr "$DEST" 2>/dev/null || true

open "$DEST"
echo "Installed and launched: $DEST"
